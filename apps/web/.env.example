# Map tiles. Default: OpenStreetMap standard tiles. Respect the tile usage policy:
# https://operations.osmfoundation.org/policies/tiles/ — use your own tile server or a
# commercial provider for production traffic.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# OSRM-compatible routing service. The public demo server is for light development use only
# (no SLA, rate limited). Run your own: https://github.com/Project-OSRM/osrm-backend
VITE_OSRM_URL=https://router.project-osrm.org
VITE_OSRM_PROFILE=driving

# Place search (Nominatim). Max 1 request/second, no autocomplete, per its usage policy.
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org

# Elevation (Open-Meteo, free for non-commercial use).
VITE_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# Optional sync backend (apps/server). Empty = local-only.
VITE_SYNC_URL=

# Development GPS simulator. Defaults to on in `vite dev`, off in production builds.
# VITE_ENABLE_SIMULATOR=true

# Accounts and cloud sync (Firebase Auth + Firestore). Leave empty for a local-only app.
# Values come from `firebase apps:sdkconfig WEB <appId>`; they are public identifiers.
VITE_FIREBASE_API_KEY=
# Use the domain the app is served from (e.g. <project>.web.app), not <project>.firebaseapp.com:
# Google / Apple sign-in then stays on the app's own site, which Safari and installed apps need.
# Add https://<that domain>/__/auth/handler as a redirect URI at Google and Apple.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_EMULATORS=true
