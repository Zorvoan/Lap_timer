VITE_FIREBASE_AUTH_DOMAIN=laptimer-okwph.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=laptimer-okwph
VITE_FIREBASE_APP_ID=1:272377945317:web:caf7e77a01a4961988480c
