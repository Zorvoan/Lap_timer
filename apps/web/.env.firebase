# Build mode used for the Firebase Hosting deployment (`npm run deploy:firebase`).
# The development GPS simulator stays available, clearly labelled, for testing without driving.
VITE_ENABLE_SIMULATOR=true

# Firebase web app config (public identifiers, not secrets: access is enforced by
