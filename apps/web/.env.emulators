# `npm run dev:emulators`: local Firebase Auth + Firestore emulators (demo project, no real data).
# Start them first: npm run emulators   (needs Java 11+ for the Firestore emulator)
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-laptimer.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-laptimer
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_EMULATORS=true
VITE_ENABLE_SIMULATOR=true
