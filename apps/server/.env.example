# PostgreSQL with PostGIS. `docker compose up -d db` from the repo root provides one.
DATABASE_URL=postgresql://laptimer:laptimer@localhost:5432/laptimer?schema=public
# "prisma" (default) or "memory" (no database; data is lost on restart — for development only).
STORAGE=prisma
PORT=8787
HOST=0.0.0.0
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:5180
# Maximum request body, bytes.
BODY_LIMIT=26214400
